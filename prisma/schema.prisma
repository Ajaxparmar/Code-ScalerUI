datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model InternshipApplication {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  college   String
  course    String
  semester  String
  createdAt DateTime @default(now())
}

model UserLead {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  email           String?
  name            String?
  interest        String?
  interactionLogs String?  // JSON string of conversation
  createdAt       DateTime @default(now())
}
